@model Aluno

<form method="post" asp-controller="Aluno" asp-action="CriarAluno">

    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>CPF</label>
        <input asp-for="Cpf" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>Data de Nascimento</label>
        <input asp-for="DataNascimento" class="form-control" type="date">
    </div>

    <div class="form-group">
        <label>Curso</label>
        <select asp-for="Curso" class="form-control">
            <option value="TADS">TADS</option>
            <option value="Agronomia Integral">Agronomia Integral</option>
            <option value="Agronomia Noturno">Agronomia Noturno</option>
        </select>
    </div>

    <button class="btn btn-success">Cadastrar</button>

</form>