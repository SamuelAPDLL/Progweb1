@model Disciplina

<form method="post" asp-controller="Disciplina" asp-action="AtualizarDisciplina">

    <div class="form-group">
        <label>Id Disciplina</label>
        <input asp-for="Id" class="form-control" type="number">
    </div>
    
    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>CargaHoraria</label>
        <input asp-for="CargaHoraria" class="form-control" type="number">
    </div>

    <div class="form-group">
        <label>Professor</label>
        <input asp-for="Professor" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>Alunos</label>
        <input asp-for="Alunos" class="form-control" type="text">            
    </div>

    <div class="form-group">
        <label>Periodo</label>
        <input asp-for="Periodo" class="form-control">            
    </div>

    <button class="btn btn-success">Cadastrar</button>

</form>