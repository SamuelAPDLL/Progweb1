@model Professor

<form method="post" asp-controller="Professor" asp-action="AtualizarProfessor">

    <div class="form-group">
        <label>Id Professor</label>
        <input asp-for="Id" class="form-control" type="number">
    </div>
    
    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>CPF</label>
        <input asp-for="Cpf" class="form-control" type="text">
    </div>

    <div class="form-group">
        <label>Data de Nascimento</label>
        <input asp-for="DataNascimento" class="form-control" type="date">
    </div>

    <div class="form-group">
        <label>Area</label>
        <select asp-for="Area" class="form-control">
            <option value="Computalãço">Computação</option>
            <option value="Agronomia">Agronomia</option>
            <option value="Matemática">Matemática</option>
        </select>
    </div>

    <button class="btn btn-success">Cadastrar</button>

</form>