@model Professor

<form method="post" asp-action="CriarProfessor">

    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" type="text" class="form-control" />
    </div>

    <div class="form-group">
        <label>CPF</label>
        <input asp-for="Cpf" type="text" class="form-control" />
    </div>

    <div class="form-group">
        <label>Siape</label>
        <input asp-for="Siape" type="text" class="form-control" />
    </div>

    <div class="form-group">
        <label>Data de Nascimento</label>
        <input asp-for="DataNascimento" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Área</label>

        <select asp-for="Area" class="form-control">
            <option value="Computação">Computação</option>
            <option value="Agronomia">Agronomia</option>
            <option value="Matemática">Matemática</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Cadastrar
    </button>

</form>